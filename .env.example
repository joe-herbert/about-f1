# Copy to .env. The server reads it on start (`npm run dev`, `npm start`).

# MariaDB connection. Matches compose.yaml for local development.
DATABASE_URL=mysql://f1stats:f1stats@localhost:3307/f1stats

# Session signing key, at least 32 characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Where people open the app. Passkeys are bound to this origin's hostname.
APP_URL=http://localhost:5173

# API server port. Vite proxies /api here in development.
PORT=3000

# Outgoing mail for sign-in codes, e.g. smtps://user:pass@smtp.example.com:465
# Leave empty in development to print codes to the server console instead.
SMTP_URL=
MAIL_FROM=About F1 <no-reply@aboutf1.com>

# Set to 1 when running behind a reverse proxy (nginx, Caddy, a load balancer)
# so sign-in rate limits apply per visitor rather than to the proxy's address.
TRUST_PROXY=
