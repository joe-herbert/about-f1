{
  "name": "f1-stats",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:server\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:web": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.ts",
    "db:up": "docker compose up -d --wait db",
    "bake:records": "node scripts/bake-records.ts",
    "scrape:pu": "node --env-file-if-exists=.env scripts/scrape-power-units.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@hono/node-server": "^2.1.4",
    "@tanstack/react-query": "^5.104.2",
    "better-auth": "^1.7.7",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "hono": "^4.13.13",
    "kysely": "^0.29.6",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.1",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^1.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
